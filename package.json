{
  "name": "nataduit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint . --type-aware --fix --ignore-path .gitignore --deny-warnings --max-warnings 0 --report-unused-disable-directives",
    "format": "oxfmt --write \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.0.8",
    "dexie": "^4.4.4",
    "react": "^19.2.6",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.6",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.60",
    "oxlint": "^1.75",
    "oxlint-tsgolint": "^7.0",
    "typescript": "~7",
    "vite": "^8",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  }
}
